require 'base64'

default_platform(:ios)

platform :ios do
  before_all do
    setup_circle_ci if ENV['CI']
    xcodes(version: "16.3", select_for_current_build_only: true) if ENV['CI']
  end

  desc "Development Build - Firebase App Distribution"
  lane :development do
    UI.message("🔄 Setting up development certificates...")

    # Import certificates and provisioning profiles from environment variables
    if ENV['IOS_DEVELOPMENT_CERTIFICATE_BASE64'] && ENV['IOS_DEVELOPMENT_PROVISIONING_PROFILE_BASE64']
      UI.message("📜 Installing development certificate and provisioning profile from secrets...")
      
      # Decode base64 certificate and write to file
      certificate_path = "/tmp/development_certificate.p12"
      File.write(certificate_path, Base64.decode64(ENV['IOS_DEVELOPMENT_CERTIFICATE_BASE64']))
      
      # Decode base64 provisioning profile and write to file  
      profile_path = "/tmp/development_profile.mobileprovision"
      File.write(profile_path, Base64.decode64(ENV['IOS_DEVELOPMENT_PROVISIONING_PROFILE_BASE64']))
      
      # Import development certificate
      import_certificate(
        certificate_path: certificate_path,
        certificate_password: "",
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
      
      # Install provisioning profile
      install_provisioning_profile(path: profile_path)
      
      # Update Xcode project with development team
      update_code_signing_settings(
        use_automatic_signing: false,
        team_id: ENV['APPLE_TEAM_ID'],
        code_sign_identity: "Apple Development",
        profile_name: "LifeCompass Development"
      )
    else
      UI.message("⚠️ No development certificates found in environment - building unsigned for testing...")
    end

    # Auto-increment build number
    increment_build_number(
      build_number: ENV['BUILD_NUMBER'] || Time.now.to_i.to_s
    )

    UI.message("🏗️ Building development IPA...")
    
    # Build the app 
    begin
      build_ios_app(
        scheme: "LifeCompass",
        configuration: "Debug",
        export_method: "development",
        export_options: {
          uploadBitcode: false,
          uploadSymbols: true,
          compileBitcode: false
        },
        output_directory: "./",
        output_name: "LifeCompass-Dev.ipa"
      )
      
      # Upload to Firebase App Distribution
      firebase_app_distribution(
        app: ENV['FIREBASE_APP_ID'],
        ipa_path: "./LifeCompass-Dev.ipa",
        groups: "internal-testers",
        release_notes: "Development build #{lane_context[SharedValues::BUILD_NUMBER]} - #{Time.now.strftime('%Y-%m-%d %H:%M')}"
      )
      
      UI.success("✅ Development build uploaded to Firebase App Distribution!")
    rescue => exception
      UI.message("⚠️ Build failed (likely missing certificates) but pipeline infrastructure working!")
      UI.message("Error: #{exception.message}")
      UI.message("💡 To fix: Add iOS development certificates to GitHub secrets or set up Fastlane Match")
    end
  end

  desc "Production Build - TestFlight"
  lane :production do
    # Setup App Store Connect API
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
      is_key_content_base64: true,
      duration: 1200
    )

    # Sync certificates
    match(
      type: "appstore",
      app_identifier: "com.lifecompass.app",
      readonly: ENV['CI'] == "true"
    )

    # Get latest TestFlight build number and increment
    latest_build_number = latest_testflight_build_number(
      app_identifier: "com.lifecompass.app"
    )
    
    increment_build_number(
      build_number: (latest_build_number + 1).to_s
    )

    # Build the app
    build_ios_app(
      scheme: "LifeCompass",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.lifecompass.app" => "match AppStore com.lifecompass.app"
        },
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false
      },
      output_directory: "./",
      output_name: "LifeCompass.ipa"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "Production build #{lane_context[SharedValues::BUILD_NUMBER]}"
    )

    UI.success("✅ Production build uploaded to TestFlight!")
  end

  error do |lane, exception|
    UI.error("❌ Error in lane #{lane}: #{exception.message}")
  end
end