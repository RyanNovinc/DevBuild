default_platform(:ios)

platform :ios do
  before_all do
    setup_circle_ci if ENV['CI']
    xcodes(version: "16.3", select_for_current_build_only: true) if ENV['CI']
  end

  desc "Development Build - Firebase App Distribution"
  lane :development do
    # Sync certificates
    match(
      type: "adhoc",
      app_identifier: "com.lifecompass.app",
      readonly: ENV['CI'] == "true"
    )

    # Auto-increment build number
    increment_build_number(
      build_number: ENV['BUILD_NUMBER'] || Time.now.to_i.to_s
    )

    # Build the app
    build_ios_app(
      scheme: "LifeCompass",
      configuration: "Debug",
      export_method: "ad-hoc",
      export_options: {
        provisioningProfiles: {
          "com.lifecompass.app" => "match AdHoc com.lifecompass.app"
        },
        compileBitcode: false
      },
      output_directory: "./",
      output_name: "LifeCompass.ipa"
    )

    # Distribute to Firebase
    firebase_app_distribution(
      app: ENV['FIREBASE_APP_ID'],
      groups: "internal-testers",
      release_notes: "Build #{ENV['BUILD_NUMBER']} from #{ENV['GITHUB_REF'] || 'local'}",
      service_credentials_file: ENV['GOOGLE_APPLICATION_CREDENTIALS']
    )

    UI.success("✅ Development build distributed to Firebase!")
  end

  desc "Production Build - TestFlight"
  lane :production do
    # Setup App Store Connect API
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY_CONTENT'],
      is_key_content_base64: true,
      duration: 1200
    )

    # Sync certificates
    match(
      type: "appstore",
      app_identifier: "com.lifecompass.app",
      readonly: ENV['CI'] == "true"
    )

    # Get latest TestFlight build number and increment
    latest_build_number = latest_testflight_build_number(
      app_identifier: "com.lifecompass.app"
    )
    
    increment_build_number(
      build_number: (latest_build_number + 1).to_s
    )

    # Build the app
    build_ios_app(
      scheme: "LifeCompass",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.lifecompass.app" => "match AppStore com.lifecompass.app"
        },
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false
      },
      output_directory: "./",
      output_name: "LifeCompass.ipa"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "Production build #{lane_context[SharedValues::BUILD_NUMBER]}"
    )

    UI.success("✅ Production build uploaded to TestFlight!")
  end

  error do |lane, exception|
    UI.error("❌ Error in lane #{lane}: #{exception.message}")
  end
end